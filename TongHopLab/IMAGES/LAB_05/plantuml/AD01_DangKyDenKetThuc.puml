@startuml AD01_DangKyDenKetThuc
skinparam defaultFontName Arial
skinparam dpi 140
skinparam shadowing false
skinparam ArrowColor #1F4E79
skinparam ActorBorderColor #1F4E79
skinparam UsecaseBorderColor #1F4E79
skinparam UsecaseBackgroundColor #F3F6FA
skinparam PackageBorderColor #7F7F7F
skinparam RectangleBorderColor #1F4E79
skinparam SequenceLifeLineBorderColor #7F7F7F
skinparam ParticipantBackgroundColor #F3F6FA
skinparam ParticipantBorderColor #1F4E79
skinparam StateBackgroundColor #F3F6FA
skinparam StateBorderColor #1F4E79
skinparam ClassBackgroundColor #F3F6FA
skinparam ClassBorderColor #1F4E79
skinparam EntityBackgroundColor #F3F6FA
skinparam ActivityBackgroundColor #F3F6FA
skinparam ActivityBorderColor #1F4E79
skinparam NoteBackgroundColor #FFF8DC
title Biểu đồ hoạt động – Từ đăng ký tour đến khi kết thúc tour
|Khách hàng|
start
:Chọn tour cần đi;
:Cung cấp số người đi;
|Nhân viên kinh doanh|
if (Số người > 12?) then (đoàn)
  :Tìm / thêm khách đoàn
  (cơ quan, người đại diện);
  :Chọn ngày đi bất kỳ,
  địa điểm đón;
  if (Mua bảo hiểm?) then (có)
    :Nhập danh sách người đi cùng;
  else (không)
  endif
  |Khách hàng|
  :Đặt cọc;
  |Nhân viên kinh doanh|
  :Lập phiếu đăng ký theo đoàn;
else (lẻ, 1..12)
  :Chọn chuyến còn chỗ;
  :Tìm / thêm khách lẻ,
  chọn điểm đón quy định;
  |Khách hàng|
  :Thanh toán tiền vé;
  |Nhân viên kinh doanh|
  :Xuất vé chuyến;
endif
|Nhân viên điều hành|
:Phân công nhân viên hướng dẫn
(không trùng lịch);
if (Đoàn hủy trước ngày đi?) then (có)
  :Hủy phiếu, giữ tiền cọc;
  stop
else (không)
endif
:Bắt đầu tour;
|Nhân viên hướng dẫn|
:Dẫn đoàn qua các nơi dừng chân,
điểm tham quan;
:Đưa khách về TP.HCM;
|Nhân viên điều hành|
:Kết thúc tour;
fork
  |Nhân viên kinh doanh|
  :Gửi phiếu khảo sát;
  :Ghi nhận góp ý;
fork again
  |Kế toán|
  if (Khách theo đoàn?) then (có)
    :Thu kinh phí còn lại;
  else (không)
  endif
end fork
|Nhân viên điều hành|
stop
@enduml
