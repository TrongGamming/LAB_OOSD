 --
 +lapPhieuGhiNo()
 +capNhatPhieuGhiNo()
 +thanhToanNo()
 +tinhSoTienConNo()
}
NhanHieu "1" -- "0..*" NuocGiaiKhat
NhaCungUng "1" -- "0..*" NuocGiaiKhat
NhaCungUng "1" -- "0..*" DonDatHang
DonDatHang "1" *-- "1..*" ChiTietDonDatHang
NuocGiaiKhat "1" -- "0..*" ChiTietDonDatHang
DonDatHang "1" -- "0..3" PhieuGiaoHang
PhieuGiaoHang "1" *-- "1..*" ChiTietPhieuGiaoHang
KhachHang "1" -- "0..*" HoaDon
HoaDon "1" *-- "1..*" ChiTietHoaDon
NuocGiaiKhat "1" -- "0..*" ChiTietHoaDon
HoaDon "1" -- "0..*" PhieuHen
KhachHang "1" -- "0..*" PhieuGhiNo
NhanVien "1" -- "0..*" HoaDon
NhanVien "1" -- "0..*" PhieuGhiNo
@enduml
