@startuml
skinparam backgroundColor white
skinparam classAttributeIconSize 0
left to right direction
class BenhNhan {
  +MaBN : String <<ID>>
  +HoTen : String
  +DiaChi : String
  +NgaySinh : Date
  +DienThoai : String
