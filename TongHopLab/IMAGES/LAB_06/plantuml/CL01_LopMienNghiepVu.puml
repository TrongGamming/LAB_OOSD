}
class PhanUngThuoc {
  +MaPU : String <<ID>>
  +NgayGhiNhan : DateTime
  +MoTa : String
  +MucDo : String
}
BenhNhan "1" -- "0..*" PhieuDangKy
PhieuDangKy "1" -- "0..1" PhiThu
BenhNhan "1" -- "0..1" HoSoBenhAn
HoSoBenhAn "1" *-- "0..*" LuotKham
HoSoBenhAn "1" -- "0..*" LichHen
LichHen "0..1" -- "0..1" LuotKham
Khoa "1" -- "0..*" BacSi
Khoa "1" -- "0..*" LuotKham
BacSi "1" -- "0..*" LuotKham
LuotKham "1" *-- "0..*" TrieuChung
LuotKham "1" *-- "0..*" ChiDinhXetNghiem
LoaiXetNghiem "1" -- "0..*" ChiDinhXetNghiem
ChiDinhXetNghiem "1" -- "0..1" KetQuaXetNghiem
LuotKham "1" -- "0..1" ToaThuoc
ToaThuoc "1" *-- "1..*" ChiTietToa
Thuoc "1" -- "0..*" ChiTietToa
HoSoBenhAn "1" -- "0..*" PhanUngThuoc
Thuoc "1" -- "0..*" PhanUngThuoc
@enduml

