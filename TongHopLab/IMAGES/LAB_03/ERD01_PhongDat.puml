@startuml
skinparam dpi 180
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide circle
entity NhanVien {
 MaNV : VARCHAR2(20) <<ID>>
 HoTen : NVARCHAR2(120)
 VaiTro : NVARCHAR2(50)
 SoDienThoai : VARCHAR2(20)
}
entity KhuVuc {
 MaKhuVuc : VARCHAR2(20) <<ID>>
 TenKhuVuc : NVARCHAR2(100)
}
entity Phong {
 SoPhong : VARCHAR2(20) <<ID>>
 MaKhuVuc : VARCHAR2(20)
 SoNguoiToiDa : NUMBER(10)
 DonGiaNgay : NUMBER(18,2)
 TrangThai : NVARCHAR2(30)
}
entity LoaiTienNghi {
 MaLoaiTN : VARCHAR2(20) <<ID>>
 TenLoaiTN : NVARCHAR2(100)
}
entity TienNghi {
 MaTienNghi : VARCHAR2(30) <<ID>>
 MaLoaiTN : VARCHAR2(20)
 SoThuTu : NUMBER(10)
 TinhTrangHienTai : NVARCHAR2(100)
}
entity PhieuLapDat {
 SoPhieuLapDat : VARCHAR2(30) <<ID>>
 MaTienNghi : VARCHAR2(30)
 SoPhong : VARCHAR2(20)
 NgayLap : DATE
 TinhTrang : NVARCHAR2(100)
 MaNV : VARCHAR2(20)
 GhiChu : NVARCHAR2(250)
}
entity KhachHang {
 MaKhach : VARCHAR2(20) <<ID>>
 HoTen : NVARCHAR2(120)
 SoCMND : VARCHAR2(30)
 QuocTich : NVARCHAR2(80)
 SoDienThoai : VARCHAR2(20)
}
entity PhieuDatPhong {
 SoPhieuDat : VARCHAR2(30) <<ID>>
 MaKhach : VARCHAR2(20)
 MaNVLeTan : VARCHAR2(20)
 NgayLap : DATE
 NgayNhan : DATE
 NgayTraDuKien : DATE
 TienCoc : NUMBER(18,2)
 KenhDat : NVARCHAR2(20)
 TrangThai : NVARCHAR2(30)
 NgayNhanThucTe : DATE
 NgayTraThucTe : DATE
}
entity ChiTietDatPhong {
 SoPhieuDat : VARCHAR2(30) <<ID>>
 SoPhong : VARCHAR2(20) <<ID>>
 SoNguoi : NUMBER(10)
 DonGiaApDung : NUMBER(18,2)
}
entity NguoiLuuTru {
 MaNguoiLT : NUMBER(10) <<ID>>
 SoPhieuDat : VARCHAR2(30)
 SoPhong : VARCHAR2(20)
 HoTen : NVARCHAR2(120)
 SoCMND : VARCHAR2(30)
 QuocTich : NVARCHAR2(80)
}
KhuVuc "1" -- "0..*" Phong : MaKhuVuc
LoaiTienNghi "1" -- "0..*" TienNghi : MaLoaiTN
TienNghi "1" -- "0..*" PhieuLapDat : MaTienNghi
Phong "1" -- "0..*" PhieuLapDat : SoPhong
NhanVien "1" -- "0..*" PhieuLapDat : MaNV
KhachHang "1" -- "0..*" PhieuDatPhong : MaKhach
NhanVien "1" -- "0..*" PhieuDatPhong : MaNVLeTan
PhieuDatPhong "1" -- "0..*" ChiTietDatPhong : SoPhieuDat
Phong "1" -- "0..*" ChiTietDatPhong : SoPhong
ChiTietDatPhong "1" -- "0..*" NguoiLuuTru : SoPhieuDat, SoPhong

@enduml
