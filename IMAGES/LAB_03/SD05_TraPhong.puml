@startuml
skinparam dpi 180
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
actor "Nhân viên" as NV
boundary FrmTraPhong as F
control TraPhongService as S
database "Oracle / Db" as DB
NV -> F : Nhập và yêu cầu xử lý
F -> S : ThanhToan(...) / TraPhong(...)
S -> S : Tổng thu không vượt hóa đơn; đủ tiền trước khi trả
alt Dữ liệu hợp lệ
 S -> DB : Lưu ThanhToan; đổi hóa đơn, phiếu đặt và phòng
 DB --> S : Kết quả
 S --> F : Thành công / dữ liệu
else Không hợp lệ hoặc lỗi
 S --> F : Thông báo lỗi; không ghi dở dang
end
F --> NV : Hiển thị kết quả
@enduml
